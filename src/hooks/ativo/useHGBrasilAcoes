import { useState, useEffect, useCallback } from 'react';
import { isTickerFII } from '@/utils/tickers';

// 🔥 HOOK OTIMIZADO PARA HG BRASIL API - DADOS DE AÇÕES BRASILEIRAS
export function useHGBrasilAcoes(ticker: string) {
  const [dadosHGBrasil, setDadosHGBrasil] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const fetchDadosAcaoHGBrasil = useCallback(async () => {
    // Validar se é ação brasileira (termina com número, mas não é FII)
    if (!ticker || !ticker.match(/\d$/) || isTickerFII(ticker)) {
      setLoading(false);
      return;
    }

    try {
      setLoading(true);
      setError(null);

      console.log(`📈 Buscando ação ${ticker} no HG Brasil...`);

      // MÉTODO 1: API interna com cache (HG Brasil)
      try {
        const apiUrl = `/api/market/hgbrasil?symbol=${encodeURIComponent(ticker)}`;
        console.log(`📡 Tentando HG Brasil via API interna para ${ticker}...`);

        const apiResponse = await fetch(apiUrl);

        if (apiResponse.ok) {
          const apiData = await apiResponse.json();
          const result = apiData?.result;

          if (result) {
            console.log(`✅ Dados HG Brasil para ${ticker}:`, result);
            
            const dadosProcessados = {
              ticker: result.symbol,
              nome: result.name,
              nomeCompleto: result.company_name,
              precoAtual: result.price,
              
              // 🎯 P/VP - O dado que você precisa!
              pvp: result.financials?.price_to_book_ratio,
              
              // P/L
              pl: result.financials?.price_earnings_ratio,
              
              // Dividend Yield 12 meses
              dividendYield12m: result.financials?.dividends?.yield_12m,
              
              // Valor Patrimonial por Ação
              valorPatrimonialAcao: result.financials?.equity_per_share,
              
              // Lucro por Ação
              lucroAcao: result.financials?.earnings_per_share,
              
              // Market Cap
              valorMercado: result.market_cap ? result.market_cap * 1000000 : null,
              
              // Dados adicionais
              setor: result.sector,
              variacaoPercent: result.change_percent,
              volume: result.volume,
              minimo52Semanas: result.low_52_weeks,
              maximo52Semanas: result.high_52_weeks,
              
              ultimaAtualizacao: result.updated_at || new Date().toISOString(),
              fonte: 'hg-brasil-cache'
            };

            setDadosHGBrasil(dadosProcessados);
            console.log(`✅ ${ticker} carregado via HG Brasil (API interna)`);
            console.log(`📊 P/VP: ${dadosProcessados.pvp || 'N/A'}`);
            return;
          }
        }
      } catch (apiError) {
        console.warn(`⚠️ HG Brasil via API interna falhou para ${ticker}:`, apiError);
      }

      // MÉTODO 2: Fallback para BRAPI
      try {
        const brapiUrl = `/api/financial/quotes?symbols=${encodeURIComponent(ticker)}&modules=summaryProfile`;
        console.log(`📡 Tentando BRAPI como fallback para ${ticker}...`);
        
        const brapiResponse = await fetch(brapiUrl);
        
        if (brapiResponse.ok) {
          const brapiData = await brapiResponse.json();
          
          const result = brapiData.results?.[0] ?? brapiData.quotes?.[0];
          if (result) {
            
            const dadosBrapi = {
              ticker: result.symbol,
              nome: result.shortName || result.longName,
              nomeCompleto: result.longName,
              precoAtual: result.regularMarketPrice,
              
              // BRAPI tem P/L mas geralmente não tem P/VP
              pl: result.priceEarnings,
              pvp: null, // BRAPI geralmente não fornece
              
              variacaoPercent: result.regularMarketChangePercent,
              volume: result.regularMarketVolume,
              valorMercado: result.marketCap,
              
              setor: result.summaryProfile?.sector || 'N/A',
              
              ultimaAtualizacao: new Date().toISOString(),
              fonte: 'brapi-fallback'
            };

            setDadosHGBrasil(dadosBrapi);
            console.log(`✅ ${ticker} carregado via BRAPI (sem P/VP)`);
            return;
          }
        }
      } catch (brapiError) {
        console.warn(`⚠️ BRAPI também falhou para ${ticker}:`, brapiError);
      }

      // Se tudo falhar, retornar null
      setDadosHGBrasil(null);
      console.log(`❌ Nenhuma fonte disponível para ${ticker}`);

    } catch (err: any) {
      console.error(`❌ Erro ao buscar ${ticker}:`, err);
      setError(`Erro ao carregar dados: ${err.message}`);
    } finally {
      setLoading(false);
    }
  }, [ticker]);

  useEffect(() => {
    fetchDadosAcaoHGBrasil();
  }, [fetchDadosAcaoHGBrasil]);

  return { 
    dadosHGBrasil, 
    loading, 
    error, 
    refetch: fetchDadosAcaoHGBrasil 
  };
}
